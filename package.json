{
  "name": "blogr-directory",
  "packageManager": "pnpm@10.12.2+sha256.07b2396c6c99a93b75b5f9ce22be9285c3b2533c49fec51b349d44798cf56b82",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "audit:blogs": "node scripts/audit-blog-health.js",
    "audit:communities": "node scripts/audit-community-health.js",
    "check:blog-updates": "node scripts/check-blog-updates.js",
    "docs:build": "node scripts/generate-blog-pages.js && vitepress build docs/",
    "docs:dev": "node scripts/generate-blog-pages.js && vitepress dev docs/ --port 5177 --strictPort",
    "docs:preview": "vitepress preview docs/",
    "format": "lint-staged --config .lintstagedrc.format.json",
    "format:all": "prettier -w --cache .",
    "format:check": "prettier --cache --check .",
    "generate:submission-form": "node scripts/generate-submission-form.js",
    "lint": "eslint --cache .",
    "lint:md": "node scripts/lint-markdown.js || true",
    "prepare": "simple-git-hooks",
    "test:blog-health": "node --test shared/blog-health-*.test.js",
    "test:blog-submissions": "node --test scripts/*blog-submission.test.js",
    "test:blog-updates": "node --test scripts/check-blog-updates.test.js",
    "test:community-health": "node --test shared/community-health.test.js",
    "test:directory-search": "node --test docs/.vitepress/directory-search.test.js",
    "test:recently-added": "node --test shared/recently-added.test.js",
    "test:seo": "node --test scripts/seo-regression.test.js",
    "test:submission-form": "node scripts/generate-submission-form.js --check"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "lint-staged": {
    "*.{js,ts,vue,json}": [
      "prettier --cache --check",
      "eslint"
    ],
    "docs/**/*.md": [
      "node scripts/lint-markdown.js"
    ]
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "consola": "^3.4.2",
    "dompurify": "^3.4.13",
    "feed": "^6.0.0",
    "mark.js": "^8.11.1",
    "minisearch": "^7.2.0",
    "nprogress": "^0.2.0",
    "reka-ui": "^2.10.3",
    "sharp": "^0.35.3",
    "unocss": "66.7.5",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/fluent": "^1.2.55",
    "@iconify-json/fluent-mdl2": "^1.2.1",
    "@iconify-json/gravity-ui": "^1.2.14",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/qlementine-icons": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/twemoji": "^1.2.5",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@vue/compiler-sfc": "^3.5.41",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "floating-vue": "^5.2.2",
    "globals": "^17.10.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-pkgsort": "^0.3.0",
    "sass": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^21.1.0",
    "vite-plugin-optimize-exclude": "^0.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-terminal": "^1.4.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
